{
  "_说明": "现场调度（井下LHD出矿）大型矿山场景配置，量级与设备参数有文献/厂商依据，具体巷道拓扑为平台自设计的典型井下布置（详见 _文据）。",

  "_文据": [
    { "要素": "铲运机 10 台（LHD）", "依据": "Sandvik 与博茨瓦纳 Khoemacau 铜矿(约13万t/a铜当量)签署 32 台地下车队订单，其中 LHD 10 台（LH621i，Discovery Alert 2022-07 报道）——本场景设备数参照该规模" },
    { "要素": "设备型号/参数（ST-14/ST-8/ST-6/Toro-007）", "依据": "Sandvik(TH/EJC/ST 系列)、Epiroc(Scooptram) 与 Toro 历史型号产品规格：斗容/宽度/空重载速度取自真实规格书，作为 LhdSpec 参数对照" },
    { "要素": "多中段出矿格局（5 个开采水平）", "依据": "贵州锦丰金矿(75万t/a→120万t/a)无轨设备应用：6 个中段、中段高约 60m，采场铲运机短运+矿卡长运模式（《黄金》期刊 2020 论文）" },
    { "要素": "巷道断面 4.8×4.0m 主巷 / 4.0~4.2m 出矿道", "依据": "GB 16423-2020《金属非金属矿山安全规程》无轨运输巷道安全净空要求 + 各型号 LHD 外廓宽 2.6~3.2m 与安全间隙的工程取值" },
    { "要素": "重载爬坡上限 13~15% / 转弯半径 6~10m", "依据": "LHD 产品规格 max_grade_loaded 与外转弯半径（Sandvik/Epiroc 技术手册），并据此约束各道坡度以区分设备通过性" },
    { "要素": "品位 0.4~1.1% Cu", "依据": "大型地下开采铜矿床入选品位典型区间（如 Khoemacau 平均约1.5% 上下、国内大型铜矿 0.5~1.0% 量级）" },
    { "要素": "单采场存量 360~640t / 中段深度 -22~-80m", "依据": "为仿真节拍自拟的合理量级设定（非文献数值）" },
    { "要素": "巷道拓扑（节点/段/长度/连接关系）", "依据": "平台自设计的典型井下布置（主巷在上、采场沿深度下移、竖井衔接主干），不投影任何单一真实矿山；仅做到形态合理" }
  ],

