API_PORT=3003
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# LS-DYNA 容器存储根（dyna2web 产物 data_v3 目录）
# 留空 = 默认 <项目根>/工作区/webapp/data_v3；剪切/迁移目录后改这里并重跑 migrate_dyna.py
DYNA_DATA_DIR=
# webapp(8765) 回调后端入库用的地址（在 start_server.py 侧读取）
# DYNA_BACKEND_URL=http://127.0.0.1:3003

# ─── 最小鉴权（方案 B1，默认关闭） ─────────────────────
# 配置后写接口（POST/PUT/DELETE）必须携带 x-api-token Header 才能调用；
# 留空则鉴权关闭（开发/本地默认）。
# BLASTING_API_TOKEN=your-secret-token
#
# 生产部署建议绑定 127.0.0.1（或置于反向代理后），避免 0.0.0.0 通配暴露。
# BLASTING_HOST=0.0.0.0
