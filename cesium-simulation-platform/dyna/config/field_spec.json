        "div": 0,
        "unit": "stress",
        "rock": 1,
        "group": "stress"
      },
      "formula": "Math.sqrt(0.5*((sxx-syy)**2+(syy-szz)**2+(szz-sxx)**2)+3*(sxy**2+syz**2+sxz**2))"
